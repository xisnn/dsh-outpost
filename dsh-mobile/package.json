{
  "name": "dsh-pocket",
  "version": "0.4.0",
  "private": true,
  "description": "DSH 原生移动客户端：工作区 / 会话 / 聊天",
  "scripts": {
    "start": "react-native start",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "typecheck": "tsc --noEmit",
    "test:fold": "tsx tests/fold-spec.mjs",
    "test:cwd": "node tests/cwd-spec.mjs",
    "test:pairing": "tsx tests/pairing-spec.mjs",
    "test:e2e": "tsx tests/e2e.mjs",
    "test": "npm run test:fold && npm run test:cwd && npm run test:pairing && npm run test:semver && npm run test:teammate && npm run test:fileref && npm run test:archive && npm run test:approval && npm run test:deliverable && npm run test:notify && npm run typecheck",
    "test:semver": "tsx tests/updater-spec.mjs",
    "test:teammate": "tsx tests/teammate-spec.mjs",
    "test:fileref": "tsx tests/fileref-spec.mjs",
    "test:archive": "node tests/archive-filter-spec.mjs",
    "test:approval": "tsx tests/approval-spec.mjs",
    "test:deliverable": "tsx tests/deliverable-spec.mjs",
    "test:notify": "tsx tests/notify-spec.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.1.0",
    "@react-native-cookies/cookies": "^6.2.1",
    "@react-native-documents/picker": "^12.0.3",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-blob-util": "^0.25.1",
    "react-native-camera-kit": "^18.0.1",
    "react-native-safe-area-context": "^5.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.81.4",
    "@react-native/eslint-config": "0.81.4",
    "@react-native/metro-config": "0.81.4",
    "@react-native/typescript-config": "0.81.4",
    "@types/react": "^19.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
